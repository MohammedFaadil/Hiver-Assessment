# Required for the LLM-headline system, LLM-as-judge, and the web demo's
# "LLM + RAG" mode. Free tier, no card required: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides -- defaults (see src/agent/config.py) are a smaller/
# faster model for drafting and a larger one for judging.
# LLM_AGENT_MODEL=openai/gpt-oss-20b
# LLM_JUDGE_MODEL=openai/gpt-oss-120b
